# Shell/Python/JS scripts and VHS tapes must stay LF — they run in Linux bash
# (Docker VHS) and via node; CRLF breaks them ("$'\r': command not found").
*.sh   text eol=lf
*.py   text eol=lf
*.mjs  text eol=lf
*.tape text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
VERSION text eol=lf

# Binaries — never normalise or diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.webm binary
*.mp3  binary
*.ico  binary
*.woff  binary
*.woff2 binary
